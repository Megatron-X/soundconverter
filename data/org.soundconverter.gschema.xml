<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema id="org.soundconverter" path="/org/soundconverter/">
    <key name="same-folder-as-input" type="b">
      <default>true</default>
      <summary>Same folder as input</summary>
      <description></description>
    </key>
    <key name="selected-folder" type="s">
      <default>''</default>
      <summary>Selected folder</summary>
      <description>os.path.expanduser('~')</description>
    </key>
    <key name="create-subfolders" type="b">
      <default>false</default>
      <summary>Create subfolders</summary>
      <description></description>
    </key>
    <key name="subfolder-pattern-index" type="i">
      <default>0</default>
      <summary>Subfolder pattern</summary>
      <description></description>
    </key>
    <key name="name-pattern-index" type="i">
      <default>0</default>
      <summary>Name pattern</summary>
      <description></description>
    </key>
    <key name="custom-filename-pattern" type="s">
      <default>'{Track} - {Title}'</default>
      <summary>Custom filename pattern</summary>
      <description></description>
    </key>
    <key name="replace-messy-chars" type="b">
      <default>false</default>
      <summary>Replace messy chars</summary>
      <description></description>
    </key>
    <key name="output-mime-type" type="s">
      <default>'audio/x-vorbis'</default>
      <summary>Output MIME type</summary>
      <description></description>
    </key>
    <key name="output-suffix" type="s">
      <default>'.ogg'</default>
      <summary>Ouput suffix</summary>
      <description></description>
    </key>
    <key name="vorbis-quality" type="d">
      <default>0.6</default>
      <summary>Vorbis quality</summary>
      <description></description>
    </key>
    <key name="vorbis-oga-extension" type="b">
      <default>false</default>
      <summary>Vorbis uses .oga extension</summary>
      <description></description>
    </key>
    <key name="mp3-mode" type="s">
      <default>'vbr'</default>
      <choices>
        <choice value="vbr"/>
        <choice value="abr"/>
        <choice value="cbr"/>
      </choices>
      <summary>MP3 mode</summary>
      <description>LAME MP3 encoding mode: VBR, ABR, CBR</description>
    </key>
    <key name="mp3-cbr-quality" type="i">
      <default>320</default>
      <range min="8" max="320"/>
      <summary>MP3 CBR bitrate</summary>
      <description>Target bitrate in kbit/s for MP3 constant bitrate encoding</description>
    </key>
    <key name="mp3-abr-quality" type="i">
      <default>192</default>
      <range min="8" max="320"/>
      <summary>MP3 ABR bitrate</summary>
      <description>Target bitrate in kbit/s for MP3 average bitrate encoding</description>
    </key>
    <key name="mp3-vbr-quality" type="i">
      <default>2</default>
      <range min="0" max="9"/>
      <summary>MP3 VBR quality</summary>
      <description>LAME VBR quality from V0 (highest) to V9 (lowest)</description>
    </key>
    <key name="mp3-engine-quality" type="s">
      <default>'high'</default>
      <choices>
        <choice value="fast"/>
        <choice value="standard"/>
        <choice value="high"/>
      </choices>
      <summary>MP3 encoding engine quality</summary>
      <description>Quality and speed setting used by the LAME MP3 encoding engine</description>
    </key>
    <key name="aac-vbr-preset" type="i">
      <default>3</default>
      <range min="1" max="5"/>
      <summary>FDK-AAC VBR quality</summary>
      <description>FDK-AAC VBR preset from 1 (very low) to 5 (very high)</description>
    </key>
    <key name="aac-afterburner" type="b">
      <default>true</default>
      <summary>FDK-AAC Afterburner</summary>
      <description>Enable the FDK-AAC Afterburner quality enhancement</description>
    </key>
    <key name="opus-bitrate" type="i">
      <default>192</default>
      <range min="4" max="650"/>
      <summary>Opus bitrate</summary>
      <description>Target Opus bitrate in kbps</description>
    </key>
    <key name="opus-bitrate-type" type="s">
      <default>'vbr'</default>
      <choices>
        <choice value="vbr"/>
        <choice value="constrained-vbr"/>
        <choice value="cbr"/>
      </choices>
      <summary>Opus bitrate mode</summary>
      <description>Opus rate control mode</description>
    </key>
    <key name="opus-audio-type" type="s">
      <default>'generic'</default>
      <choices>
        <choice value="generic"/>
        <choice value="voice"/>
      </choices>
      <summary>Opus audio type</summary>
     <description>Type of audio to optimize for</description>
    </key>
    <key name="opus-bandwidth" type="s">
      <default>'auto'</default>
      <choices>
        <choice value="auto"/>
        <choice value="narrowband"/>
        <choice value="mediumband"/>
        <choice value="wideband"/>
        <choice value="superwideband"/>
        <choice value="fullband"/>
      </choices>
      <summary>Opus bandwidth</summary>
      <description>Opus audio bandwidth</description>
    </key>
    <key name="opus-frame-size" type="d">
      <default>20.0</default>
      <range min="2.5" max="60.0"/>
      <summary>Opus frame size</summary>
      <description>Opus frame duration in milliseconds</description>
    </key>
    <key name="wma-bitrate" type="i">
      <default>192</default>
      <summary>WMA bitrate</summary>
      <description></description>
    </key>
    <key name="flac-compression" type="i">
      <default>8</default>
      <summary>Flac compression level</summary>
      <description></description>
    </key>
    <key name="wav-sample-width" type="i">
      <default>16</default>
      <summary>Wav sample width</summary>
      <description></description>
    </key>
    <key name="delete-original" type="b">
      <default>false</default>
      <summary>Delete original</summary>
      <description></description>
    </key>
    <key name="output-resample" type="b">
      <default>false</default>
      <summary>Resample output</summary>
      <description></description>
    </key>
    <key name="resample-rate" type="i">
      <default>48000</default>
      <summary>Resample rate</summary>
      <description></description>
    </key>
    <key name="force-mono" type="b">
      <default>false</default>
      <summary>Force mono output</summary>
      <description></description>
    </key>
    <key name="last-used-folder" type="s">
      <default>''</default>
      <summary>Last used folder</summary>
      <description></description>
    </key>
    <key name="limit-jobs" type="b">
      <default>false</default>
      <summary>Limit jobs</summary>
      <description></description>
    </key>
    <key name="number-of-jobs" type="i">
      <default>1</default>
      <summary>Number of jobs</summary>
      <description></description>
    </key>
  </schema>
</schemalist>
        
